{issue.description && (() => {
  const { main, quotes } = splitEvidence(issue.description);
  return (
    <>
      {main && (
        <p className="text-sm text-ink-2 leading-relaxed whitespace-pre-line">
          {main}
        </p>
      )}
      {quotes.length > 0 && (
        <details className="mt-2 group" open>
          <summary className="cursor-pointer select-none text-[11px] font-medium uppercase tracking-wider text-ink-3 hover:text-accent transition-colors">
            🔎 Источник · дословные цитаты ({quotes.length})
          </summary>
          <div className="mt-2 space-y-2">
            {quotes.map((q, i) => (
              <blockquote
                key={i}
                className="border-l-2 border-accent/60 pl-3 py-1 text-sm italic text-ink-2"
              >
                «{q.text}»
                {q.speaker && (
                  <footer className="mt-1 text-[11px] not-italic text-ink-4">
                    — {q.speaker}, встреча (запись)
                  </footer>
                )}
              </blockquote>
            ))}
          </div>
        </details>
      )}
    </>
  );
})()}
